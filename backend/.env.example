# ── Base de données (Railway PostgreSQL) ───────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Serveur ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── URLs ───────────────────────────────────────────────────────────────────────
# FRONTEND_URL = URL Vercel de ton frontend (ex: https://maison-marnoa.vercel.app)
FRONTEND_URL="https://maison-marnoa.vercel.app"
# BACKEND_URL = URL Railway de ton backend (fournie automatiquement par Railway)
BACKEND_URL="https://maison-marnoa-backend.up.railway.app"

# ── Better Auth ────────────────────────────────────────────────────────────────
# Générer avec: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="https://maison-marnoa-backend.up.railway.app/api/auth"
BETTER_AUTH_TRUSTED_ORIGINS="https://maison-marnoa.vercel.app"

# ── WhatsApp admin ─────────────────────────────────────────────────────────────
# Format international sans le +  (ex: 221XXXXXXXXX pour le Sénégal)
ADMIN_WHATSAPP_NUMBER="221XXXXXXXXX"

# ── Cloudinary (upload images produits admin) ───────────────────────────────────
# Variables VITE_ injectées au build Vite — à inclure dans .env.production sur le VPS
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"
VITE_CLOUDINARY_UPLOAD_PRESET="your_unsigned_preset_name"
